@{
    ViewData["Title"] = "Forbidden · 403";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #f8faf8;
            font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 0 3rem;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .err-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 0;
            border-bottom: 1px solid #e6ebe7;
        }

        .err-brand {
            color: #183D30;
            font-weight: 600;
            font-size: 16px;
            text-decoration: none;
            line-height: 1.2;
        }

        .err-breadcrumb {
            color: #66736C;
            font-weight: 400;
            font-size: 13px;
            line-height: 1.2;
        }

        .err-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 3rem 1rem;
        }

        .err-code {
            color: #C9DDD0;
            font-family: "Inter", sans-serif;
            font-weight: 600;
            font-size: 172px;
            line-height: 0.92;
            letter-spacing: -0.05em;
            font-variant-numeric: lining-nums tabular-nums;
            margin-bottom: 1.5rem;
            user-select: none;
        }

        .err-kicker {
            color: #276145;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            margin-bottom: 0.75rem;
        }

        .err-title {
            color: #152D23;
            font-weight: 600;
            font-size: 36px;
            line-height: 1.2;
            letter-spacing: -0.025em;
            margin-bottom: 0.85rem;
        }

        .err-description {
            color: #647168;
            font-weight: 400;
            font-size: 16px;
            max-width: 460px;
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .err-actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

        .err-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.65rem 1.35rem;
            font-family: "Inter", sans-serif;
            font-weight: 600;
            font-size: 14px;
            border-radius: 6px;
            text-decoration: none;
            cursor: pointer;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

        .err-btn-secondary {
            background-color: #ffffff;
            color: #344A3E;
            border: 1px solid #d5ddd7;
        }

            .err-btn-secondary:hover {
                background-color: #f1f5f2;
                border-color: #c2cdc5;
            }

        .err-btn-primary {
            background-color: #1E513B;
            color: #FFFFFF;
            border: 1px solid #1E513B;
        }

            .err-btn-primary:hover {
                background-color: #173f2e;
                border-color: #173f2e;
            }

        .err-hint {
            color: #6B786F;
            font-weight: 400;
            font-size: 12px;
        }

        .err-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 0;
            border-top: 1px solid #e6ebe7;
        }

        .err-footer-left {
            color: #68766C;
            font-weight: 500;
            font-size: 12px;
        }

        .err-footer-right {
            color: #68766C;
            font-weight: 400;
            font-size: 12px;
        }

        @@media (max-width: 640px) {
            body {
                padding: 0 1.25rem;
            }

            .err-code {
                font-size: 108px;
            }

            .err-title {
                font-size: 28px;
            }

            .err-footer {
                flex-direction: column;
                gap: 0.5rem;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <header class="err-header">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="err-brand">Administration</a>
        <span class="err-breadcrumb">Error / Forbidden</span>
    </header>

    <main class="err-main">
        <div class="err-code">403</div>
        <p class="err-kicker">FORBIDDEN</p>
        <h1 class="err-title">You don’t have access to this page</h1>
        <p class="err-description">
            Your account doesn’t have permission to view this page.<br />
            If you need access, contact your administrator.
        </p>

        <div class="err-actions">
            <button type="button" class="err-btn err-btn-secondary" onclick="history.back()">Go back</button>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="err-btn err-btn-primary">Back to home</a>
        </div>

        <p class="err-hint">Make sure you’re signed in with the correct account.</p>
    </main>

    <footer class="err-footer">
        <span class="err-footer-left">403 · Forbidden</span>
        <span class="err-footer-right">Contact your administrator.</span>
    </footer>
</body>
</html>