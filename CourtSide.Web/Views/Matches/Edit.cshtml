@model CourtSide.ViewModels.Matches.MatchFormViewModel
@using CourtSide.Common.MatchEnumerations

@{
    ViewData["Title"] = "Edit Match";
}

@section MainStyle {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

    <style>
        .create-match-bg {
            background-color: #5B3A2A;
            min-height: calc(100vh - 56px);
            padding: 2rem 1rem 4rem 1rem;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        .create-match-card {
            max-width: 680px;
            width: 100%;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: #1e293b;
        }

        .modal-header-custom {
            background-color: #0C2D23;
            color: #ffffff;
            padding: 1.5rem 1.75rem;
            position: relative;
        }

        .modal-header-tag {
            font-size: 10px !important;
            font-weight: 700 !important;
            letter-spacing: 1px;
            color: #B7CDBF;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 0.5rem;
        }

        .modal-header-tag-dot {
            width: 6px;
            height: 6px;
            background-color: #D5EF68;
            border-radius: 50%;
        }

        .modal-title-custom {
            font-size: 30px !important;
            font-weight: 600 !important;
            margin-bottom: 0.25rem;
            letter-spacing: -0.3px;
            color: #ffffff;
        }

        .modal-subtitle-custom {
            font-size: 13px !important;
            font-weight: 400 !important;
            color: #B7CDBF;
        }

        .form-section-header {
            font-size: 15px !important;
            font-weight: 600 !important;
            color: #142F26 !important;
            margin-top: 1.25rem;
            margin-bottom: 0.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .required-fields-note {
            font-size: 11px !important;
            font-weight: 400 !important;
            color: #708078;
        }

        .section-header-note {
            font-size: 11px !important;
            font-weight: 400 !important;
            color: #708078 !important;
        }

        .custom-form-label {
            font-size: 12px !important;
            font-weight: 600 !important;
            color: #142F26 !important;
            margin-bottom: 0.35rem;
        }

        .required-asterisk {
            color: #123F30 !important;
            font-weight: 700;
        }

        .custom-form-control {
            border: 1px solid #CBD5E1;
            border-radius: 6px;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: #142F26 !important;
            background-color: #ffffff;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }

            .custom-form-control option {
                color: #142F26 !important;
                background-color: #ffffff;
            }

            .custom-form-control:focus {
                border-color: #0E3628;
                box-shadow: 0 0 0 2px rgba(14, 54, 40, 0.15);
                outline: none;
            }

            .custom-form-control[readonly] {
                background-color: #F8FAFC !important;
                color: #64748B !important;
                cursor: not-allowed;
            }

        #dateTimePicker {
            background-color: #ffffff !important;
            cursor: pointer !important;
        }

        .toggle-group {
            display: flex;
            background-color: #F1F5F9;
            border-radius: 6px;
            padding: 3px;
            gap: 4px;
        }

        .toggle-btn {
            flex: 1;
            border: 1px solid transparent;
            padding: 0.45rem;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .toggle-btn.active {
                background-color: #123F30 !important;
                color: #ffffff !important;
                border: 1px solid #123F30 !important;
                font-size: 13px !important;
                font-weight: 600 !important;
            }

            .toggle-btn:not(.active) {
                background-color: #F5F6F2 !important;
                color: #708078 !important;
                border: 1px solid transparent !important;
                font-size: 13px !important;
                font-weight: 500 !important;
            }

        .field-subtext {
            font-size: 11px !important;
            font-weight: 400 !important;
            color: #64748B;
            margin-top: 0.25rem;
        }

        .modal-footer-custom {
            background-color: #F8FAFC;
            border-top: 1px solid #E2E8F0;
            padding: 1rem 1.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-cancel-custom {
            border: 1px solid #CBD5E1;
            background-color: #ffffff;
            color: #142F26 !important;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.5rem 1.25rem;
            border-radius: 6px;
            text-decoration: none;
            transition: background-color 0.15s ease;
        }

            .btn-cancel-custom:hover {
                background-color: #F1F5F9;
                color: #142F26 !important;
            }

        .btn-submit-custom {
            background-color: #123F30 !important;
            color: #ffffff;
            border: none;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.5rem 1.25rem;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background-color 0.15s ease;
        }

            .btn-submit-custom:hover {
                background-color: #164e3b;
            }

        span.text-danger {
            font-size: 0.7rem !important;
            display: block;
            margin-top: 2px;
        }

        /* CUSTOM FLATPICKR CALENDAR THEME */
        .flatpickr-calendar {
            border-radius: 8px !important;
            box-shadow: 0 10px 25px rgba(0,0,0,0.18) !important;
            font-family: 'Inter', sans-serif !important;
            border: 1px solid #E2E8F0 !important;
            overflow: hidden;
        }

        .flatpickr-months {
            background-color: #1139BD !important;
            color: #ffffff !important;
            padding-top: 4px;
        }

            .flatpickr-months .flatpickr-month,
            .flatpickr-current-month .flatpickr-monthDropdown-months,
            .flatpickr-current-month input.cur-year {
                color: #ffffff !important;
                font-weight: 600 !important;
            }

            .flatpickr-months .flatpickr-prev-month svg,
            .flatpickr-months .flatpickr-next-month svg {
                fill: #ffffff !important;
            }

        span.flatpickr-weekday {
            background-color: #172554 !important;
            color: #93c5fd !important;
            font-weight: 600 !important;
        }

        .flatpickr-day.selected,
        .flatpickr-day.selected:hover,
        .flatpickr-day.selected:focus {
            background: #172554 !important;
            border-color: #172554 !important;
            color: #ffffff !important;
            font-weight: 600;
        }

        .flatpickr-day.today {
            border-color: #172554 !important;
        }

            .flatpickr-day.today:hover {
                background: #E2E8F0 !important;
            }

        .flatpickr-time input:hover,
        .flatpickr-time .flatpickr-am-pm:hover,
        .flatpickr-time input:focus,
        .flatpickr-time .flatpickr-am-pm:focus {
            background: #F1F5F9 !important;
        }

        #courtSelect {
            position: relative;
            z-index: 99999;
            pointer-events: auto !important;
            background-image: none !important;
            appearance: auto !important;
            -webkit-appearance: menulist !important;
            -moz-appearance: menulist !important;
        }
    </style>
}

<div class="create-match-bg">
    <div class="create-match-card">
        <!-- HEADER -->
        <div class="modal-header-custom">
            <div class="modal-header-tag">
                <span class="modal-header-tag-dot"></span> COURTSIDE / ADMINISTRATOR
            </div>
            <h2 class="modal-title-custom">Edit Match</h2>
            <p class="modal-subtitle-custom mb-0">Update schedule, players, status, or results for this match.</p>
        </div>

        <!-- FORM BODY -->
        <form asp-action="Edit" method="post" class="p-4">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- SECTION 1: TOURNAMENT & EVENT -->
            <div class="form-section-header">
                <span>Tournament & event</span>
                <span class="required-fields-note"><span class="required-asterisk">*</span> Required fields</span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Tour" class="custom-form-label">
                        Tour <span class="required-asterisk">*</span>
                    </label>
                    <select asp-for="Tour" id="tourSelect" class="form-select custom-form-control">
                        <option value="">-- Select Tour --</option>
                        <option value="ATP">ATP</option>
                        <option value="WTA">WTA</option>
                    </select>
                    <span asp-validation-for="Tour" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="custom-form-label">Discipline <span class="required-asterisk">*</span></label>
                    <input type="hidden" id="disciplineInput" name="Discipline" value="Singles" />
                    <div class="toggle-group" id="disciplineToggleGroup">
                        <button type="button" class="toggle-btn active" data-value="Singles">Singles</button>
                        <button type="button" class="toggle-btn" data-value="Doubles">Doubles</button>
                    </div>
                </div>
            </div>

    <div class="mb-3">
    <label asp-for="TournamentId" class="custom-form-label">
        Tournament <span class="required-asterisk">*</span>
    </label>
    <select asp-for="TournamentId" id="TournamentId" class="form-select custom-form-control">
        <option value="">-- Please select a tour first --</option>
        @if (Model.Tournaments != null)
        {
            @foreach (var t in Model.Tournaments)
            {
                <option value="@t.Id"
                        selected="@(t.Id == Model.TournamentId ? "selected" : null)"
                        data-venue-id="@t.VenueId"
                        data-surface="@((int)t.CourtSurface)"
                        data-environment="@((int)t.CourtEnvironment)">
                    @t.Name
                </option>
            }
        }
    </select>
    <span asp-validation-for="TournamentId" class="text-danger"></span>
    <div id="tournamentSubtext" class="field-subtext">Select an ATP or WTA tour above to populate the available tournaments.</div>
</div>

            <!-- SECTION 2: OPPONENTS -->
            <div class="form-section-header">
                <span>Opponents</span>
                <span id="opponentsSubtext" class="section-header-note"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="FirstPlayerId" class="custom-form-label">Player 1 <span class="required-asterisk">*</span></label>
                    <select asp-for="FirstPlayerId" asp-items="Model.Players" id="firstPlayerSelect" class="form-select custom-form-control">
                        <option value="">-- Please select a tournament first --</option>
                    </select>
                    <span asp-validation-for="FirstPlayerId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SecondPlayerId" class="custom-form-label">Player 2 <span class="required-asterisk">*</span></label>
                    <select asp-for="SecondPlayerId" asp-items="Model.Players" id="secondPlayerSelect" class="form-select custom-form-control">
                        <option value="">-- Please select a tournament first --</option>
                    </select>
                    <span asp-validation-for="SecondPlayerId" class="text-danger"></span>
                </div>
            </div>

            <!-- SECTION 3: SCHEDULE & MATCH SETTINGS -->
            <div class="form-section-header">
                <span>Schedule & match settings</span>
            </div>

            <div class="row g-3 mb-2">
                <div class="col-md-6">
                    <label asp-for="DateTime" class="custom-form-label">Scheduled date & time <span class="required-asterisk">*</span></label>
                    <input asp-for="DateTime" id="dateTimePicker" class="form-control custom-form-control" type="text" placeholder="Select date & time..." />
                    <span asp-validation-for="DateTime" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MatchStatus" class="custom-form-label">Initial status <span class="required-asterisk">*</span></label>
                    <select asp-for="MatchStatus" asp-items="Html.GetEnumSelectList<MatchStatus>()" class="form-select custom-form-control">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="MatchStatus" class="text-danger"></span>
                </div>
            </div>
            <div class="field-subtext mb-3">Scheduled matches appear as upcoming. Scores remain empty until play begins.</div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="MatchRound" class="custom-form-label">Round <span class="required-asterisk">*</span></label>
                    <select asp-for="MatchRound" asp-items="Html.GetEnumSelectList<MatchRound>()" class="form-select custom-form-control">
                        <option value="">-- Select Match Round --</option>
                    </select>
                    <span asp-validation-for="MatchRound" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CourtName" for="courtSelect" class="custom-form-label">Court <span class="required-asterisk">*</span></label>
                    <select asp-for="CourtName" asp-items="Model.Courts" id="courtSelect" class="form-select custom-form-control">
                        <option value="">-- Please select a tournament first --</option>
                    </select>
                    <span asp-validation-for="CourtName" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="VenueId" class="custom-form-label">Venue <span class="required-asterisk">*</span></label>
                    <input type="hidden" asp-for="VenueId" id="venueIdInput" />
                    <input type="text" id="venueNameInput" class="form-control custom-form-control" readonly placeholder="Auto-selected from tournament" />
                    <span asp-validation-for="VenueId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="custom-form-label">Surface/Environment <span class="required-asterisk">*</span></label>
                    <input type="hidden" asp-for="CourtSurface" id="courtSurfaceInput" />
                    <input type="hidden" asp-for="CourtEnvironment" id="courtEnvironmentInput" />
                    <input type="text" id="surfaceEnvironmentInput" class="form-control custom-form-control" readonly placeholder="Auto-selected from tournament" />
                    <span asp-validation-for="CourtSurface" class="text-danger"></span>
                </div>
            </div>

            <!-- SECTION 4: RESULTS (OPTIONAL) -->
            <div class="form-section-header">
                <span>Results (Optional)</span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="ScoreResult" class="custom-form-label">Score Result</label>
                    <input asp-for="ScoreResult" id="scoreResultInput" class="form-control custom-form-control" placeholder="e.g. 6-4, 6-3" />
                    <span asp-validation-for="ScoreResult" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="WinnerId" class="custom-form-label">Winner</label>
                    <select asp-for="WinnerId" id="winnerSelect" class="form-select custom-form-control" disabled>
                        <option value="">-- Select Winner --</option>
                    </select>
                    <span asp-validation-for="WinnerId" class="text-danger"></span>
                </div>
            </div>

            <!-- FOOTER ACTIONS -->
            <div class="modal-footer-custom mx-n4 mb-n4">
                <div class="small text-muted"></div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn-cancel-custom">Cancel</a>
                    <button type="submit" class="btn-submit-custom">
                        Save Changes <i class="bi bi-box-arrow-up-right ms-1"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        document.addEventListener('DOMContentLoaded', async function() {
            // Initialize Flatpickr for Date & Time
            flatpickr("#dateTimePicker", {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                time_24hr: true,
                defaultHour: 14,
                defaultMinute: 0
            });

            const tournamentSelect = document.getElementById('TournamentId');
            const tourSelect = document.getElementById('tourSelect');
            const venueIdInput = document.getElementById('venueIdInput');
            const venueNameInput = document.getElementById('venueNameInput');
            const courtSelect = document.getElementById('courtSelect');
            const courtSurfaceInput = document.getElementById('courtSurfaceInput');
            const courtEnvironmentInput = document.getElementById('courtEnvironmentInput');
            const surfaceEnvironmentInput = document.getElementById('surfaceEnvironmentInput');
            const tournamentSubtext = document.getElementById('tournamentSubtext');
            const opponentsSubtext = document.getElementById('opponentsSubtext');
            const firstPlayer = document.getElementById('firstPlayerSelect');
            const secondPlayer = document.getElementById('secondPlayerSelect');
            const winnerSelect = document.getElementById('winnerSelect');
            const matchStatusSelect = document.querySelector('[name="MatchStatus"]');
            const scoreResultInput = document.getElementById('scoreResultInput');
            const matchForm = document.querySelector('form');

            const disciplineInput = document.getElementById('disciplineInput');
            const disciplineToggleGroup = document.getElementById('disciplineToggleGroup');

            const initialTournamentId = @Json.Serialize(Model.TournamentId.ToString());
            const initialStatusValue = @Json.Serialize(Model.MatchStatus.HasValue ? ((int)Model.MatchStatus.Value).ToString() : "");
            const initialCourtValue = @Json.Serialize(Model.CourtName ?? "");
            const initialWinnerValue = @Json.Serialize(Model.WinnerId?.ToString() ?? "");
            const initialVenueId = @Json.Serialize(Model.VenueId.ToString());
            const initialTourValue = @Json.Serialize(Model.Tour?.ToString() ?? "");
            const initialFirstPlayer = @Json.Serialize(Model.FirstPlayerId?.ToString() ?? "");
            const initialSecondPlayer = @Json.Serialize(Model.SecondPlayerId?.ToString() ?? "");
            const initialRoundValue = @Json.Serialize(Model.MatchRound.ToString());

            // Enum Lookup Mappings
            const surfaceMap = {
                0: 'Grass',
                1: 'Clay',
                2: 'Hard',
                3: 'Carpet'
            };

            const environmentMap = {
                0: 'Indoor',
                1: 'Outdoor'
            };

            let allVenuesMap = {};

            async function loadAllVenues() {
                try {
                    const response = await fetch('/Matches/GetAllVenues');
                    if (!response.ok) return;
                    const venues = await response.json();

                    allVenuesMap = {};
                    venues.forEach(v => {
                        allVenuesMap[v.id] = v.name;
                    });

                    if (initialVenueId && initialVenueId !== "0" && allVenuesMap[initialVenueId]) {
                        venueIdInput.value = initialVenueId;
                        venueNameInput.value = allVenuesMap[initialVenueId];
                    }
                } catch (error) {
                    console.error('Error loading venues:', error);
                }
            }

            // 1. Set initial tour & tournament values
            if (initialTourValue && tourSelect) {
                tourSelect.value = initialTourValue;
            }

            if (initialTournamentId && tournamentSelect) {
                tournamentSelect.value = initialTournamentId;
            }

            // 2. Fetch venues and populate venue/surface metadata
            await loadAllVenues();

            if (initialTournamentId && tournamentSelect) {
                const selectedOption = tournamentSelect.options[tournamentSelect.selectedIndex];
                if (selectedOption && selectedOption.value) {
                    const surfaceVal = selectedOption.getAttribute('data-surface');
                    const envVal = selectedOption.getAttribute('data-environment');

                    if (surfaceVal !== null && surfaceMap[surfaceVal]) {
                        const surfaceText = surfaceMap[surfaceVal];
                        const envText = envVal !== null && environmentMap[envVal] ? environmentMap[envVal] : '';
                        
                        surfaceEnvironmentInput.value = envText ? `${envText} ${surfaceText}` : surfaceText;
                        if (courtSurfaceInput) courtSurfaceInput.value = surfaceVal;
                        if (courtEnvironmentInput) courtEnvironmentInput.value = envVal;
                    }
                }
            }

            // 3. Status UI & Winner Dropdown Synchronization
            function syncMatchStatusUI() {
                if (!matchStatusSelect || !winnerSelect) return;

                const selectedOption = matchStatusSelect.options[matchStatusSelect.selectedIndex];
                const statusText = selectedOption ? selectedOption.text.trim() : "";
                const isCompleted = statusText === "Completed" || matchStatusSelect.value === "Completed";

                if (isCompleted) {
                    winnerSelect.disabled = false;

                    const currentWinner = winnerSelect.value || initialWinnerValue;
                    winnerSelect.innerHTML = '<option value="">-- Select Winner --</option>';

                    [firstPlayer, secondPlayer].forEach(playerSelect => {
                        if (playerSelect && playerSelect.value) {
                            const pOption = playerSelect.options[playerSelect.selectedIndex];
                            const opt = document.createElement('option');
                            opt.value = playerSelect.value;
                            opt.textContent = pOption.text;
                            if (opt.value === currentWinner) {
                                opt.selected = true;
                            }
                            winnerSelect.appendChild(opt);
                        }
                    });
                } else {
                    winnerSelect.value = "";
                    winnerSelect.disabled = true;
                }
            }

            if (matchStatusSelect) {
                matchStatusSelect.value = initialStatusValue;
                matchStatusSelect.addEventListener('change', syncMatchStatusUI);
                syncMatchStatusUI();
            }

            function updateOpponentsSubtext() {
                if (!opponentsSubtext) return;
                const tour = tourSelect.value;
                const discipline = disciplineInput ? disciplineInput.value : 'Singles';

                let genderPrefix = '';
                if (tour === 'ATP') genderPrefix = "Men's";
                else if (tour === 'WTA') genderPrefix = "Women's";

                if (genderPrefix && discipline) {
                    opponentsSubtext.textContent = `${genderPrefix} ${discipline.toLowerCase()}`;
                } else if (discipline) {
                    opponentsSubtext.textContent = discipline;
                } else {
                    opponentsSubtext.textContent = "";
                }
            }

            if (disciplineToggleGroup) {
                const buttons = disciplineToggleGroup.querySelectorAll('.toggle-btn');
                buttons.forEach(btn => {
                    btn.addEventListener('click', function() {
                        buttons.forEach(b => b.classList.remove('active'));
                        this.classList.add('active');

                        const selectedDiscipline = this.getAttribute('data-value');
                        if (disciplineInput) {
                            disciplineInput.value = selectedDiscipline;
                        }
                        updateOpponentsSubtext();
                    });
                });
            }
        });
    </script>
}

            async function fetchAndPopulatePlayers(url) {
                try {
                    const response = await fetch(url);
                    if (!response.ok) return;
                    const players = await response.json();

                    const currentFirst = firstPlayer.value || initialFirstPlayer;
                    const currentSecond = secondPlayer.value || initialSecondPlayer;

                    [firstPlayer, secondPlayer].forEach(selectElement => {
                        if (selectElement) {
                            selectElement.innerHTML = selectElement.id === 'firstPlayerSelect'
                                ? '<option value="">-- Select First Player --</option>'
                                : '<option value="">-- Select Second Player --</option>';

                            players.forEach(p => {
                                const option = document.createElement('option');
                                option.value = p.id;
                                option.textContent = p.fullName || (p.firstName + ' ' + p.lastName);
                                selectElement.appendChild(option);
                            });

                            selectElement.disabled = false;
                        }
                    });

                    if (currentFirst && Array.from(firstPlayer.options).some(o => o.value === currentFirst)) {
                        firstPlayer.value = currentFirst;
                    }
                    if (currentSecond && Array.from(secondPlayer.options).some(o => o.value === currentSecond)) {
                        secondPlayer.value = currentSecond;
                    }

                    filterPlayerOptions();
                } catch (error) {
                    console.error('Error fetching players:', error);
                }
            }

            async function fetchAndPopulateCourts(venueId) {
                if (!courtSelect) return;

                if (!venueId || venueId === "0" || venueId === "null" || venueId === null || venueId === undefined) {
                    courtSelect.innerHTML = '<option value="">-- Please select a tournament first --</option>';
                    courtSelect.disabled = true;
                    courtSelect.value = '';
                    return;
                }

                try {
                    const response = await fetch(`/Matches/GetCourtsByVenue?venueId=${encodeURIComponent(venueId)}`);
                    if (!response.ok) return;
                    const courts = await response.json();

                    const currentCourt = courtSelect.value || initialCourtValue;
                    courtSelect.innerHTML = '<option value="">-- Select Court --</option>';

                    courts.forEach(c => {
                        const option = document.createElement('option');
                        const courtName = c.name || c.Name || c.courtName || c.CourtName;
                        option.value = courtName;
                        option.textContent = courtName;
                        courtSelect.appendChild(option);
                    });

                    debugger;
                    courtSelect.removeAttribute('disabled');
                    courtSelect.disabled = false;

                    courtSelect.style.display = 'none';
                    courtSelect.offsetHeight;
                    courtSelect.style.display = 'block';

                    if (currentCourt && Array.from(courtSelect.options).some(o => o.value === currentCourt)) {
                        courtSelect.value = currentCourt;
                        courtSelect.dispatchEvent(new Event('change')); 
                    }

                    
                } catch (error) {
                    console.error('Error fetching courts:', error);
                }
            }

            function clearAndDisablePlayers() {
                [firstPlayer, secondPlayer].forEach(selectElement => {
                    if (selectElement) {
                        selectElement.innerHTML = '<option value="">-- Please select a tournament first --</option>';
                        selectElement.value = '';
                        selectElement.disabled = true;
                    }
                });
                filterPlayerOptions();
            }

            function clearAndDisableCourts() {
                if (courtSelect) {
                    courtSelect.innerHTML = '<option value="">-- Please select a tournament first --</option>';
                    courtSelect.value = '';
                    courtSelect.disabled = true;
                }
            }

            async function syncTournamentMetadata() {
                 if (!tournamentSelect) return;
                
                 const selectedOption = tournamentSelect.options[tournamentSelect.selectedIndex];
                
                 const venueId = selectedOption ? selectedOption.getAttribute('data-venue-id') : null;
                 
                 if (venueId && venueId !== "0") {
                     if (venueIdInput) venueIdInput.value = venueId;
                     
                     // Safely set venue name if dictionary exists, otherwise leave/handle it
                     if (venueNameInput && typeof allVenuesMap !== 'undefined' && allVenuesMap[venueId]) {
                         venueNameInput.value = allVenuesMap[venueId];
                     }
                
                     // CRITICAL: Fetch courts directly when venueId is present, regardless of allVenuesMap
                     await fetchAndPopulateCourts(venueId);
                 } else {
                     if (venueIdInput) venueIdInput.value = "";
                     if (venueNameInput) venueNameInput.value = "";
                     clearAndDisableCourts();
                 }
                
                 const surfaceVal = selectedOption ? selectedOption.getAttribute('data-surface') : null;
                 const envVal = selectedOption ? selectedOption.getAttribute('data-environment') : null;
                
                 if (surfaceVal && envVal) {
                     if (courtSurfaceInput) courtSurfaceInput.value = surfaceVal;
                     if (courtEnvironmentInput) courtEnvironmentInput.value = envVal;
                
                     const envText = (typeof environmentMap !== 'undefined' && environmentMap[envVal]) ? environmentMap[envVal] : envVal;
                     const surfText = (typeof surfaceMap !== 'undefined' && surfaceMap[surfaceVal]) ? surfaceMap[surfaceVal] : surfaceVal;
                
                     if (surfaceEnvironmentInput) {
                         surfaceEnvironmentInput.value = `${envText} ${surfText}`.trim();
                     }
                 } else {
                     if (courtSurfaceInput) courtSurfaceInput.value = "";
                     if (courtEnvironmentInput) courtEnvironmentInput.value = "";
                     if (surfaceEnvironmentInput) surfaceEnvironmentInput.value = "";
                 }
              }

            async function handleTourChange() {
                const selectedTour = tourSelect.value;

                clearAndDisablePlayers();
                clearAndDisableCourts();

                if (!selectedTour) {
                    if (tournamentSubtext) tournamentSubtext.textContent = "Select an ATP or WTA tour above to populate the available tournaments.";
                    updateOpponentsSubtext();
                    tournamentSelect.innerHTML = '<option value="">-- Please select a tour first --</option>';
                    tournamentSelect.disabled = true;
                    venueIdInput.value = "";
                    venueNameInput.value = "";
                    if (courtSurfaceInput) courtSurfaceInput.value = "";
                    if (courtEnvironmentInput) courtEnvironmentInput.value = "";
                    if (surfaceEnvironmentInput) surfaceEnvironmentInput.value = "";
                    return;
                }

                if (selectedTour === 'ATP') {
                    if (tournamentSubtext) tournamentSubtext.textContent = "ATP Tournaments • Men's division";
                } else if (selectedTour === 'WTA') {
                    if (tournamentSubtext) tournamentSubtext.textContent = "WTA Tournaments • Women's division";
                }
                updateOpponentsSubtext();

                try {
                    const tourResponse = await fetch(`/Matches/GetTournamentsByTour?tour=${encodeURIComponent(selectedTour)}`);
                    if (tourResponse.ok) {
                        const tournaments = await tourResponse.json();
                        const currentTournamentVal = tournamentSelect.value || initialTournamentId;

                        tournamentSelect.innerHTML = '<option value="">-- Select Tournament --</option>';

                        tournaments.forEach(t => {
                            const option = document.createElement('option');
                            option.value = t.id ?? t.Id;
                            option.textContent = t.name ?? t.Name ?? t.tournamentName ?? "Tournament";

                            const venueId = t.venueId ?? t.VenueId;
                            const surface = t.courtSurface ?? t.CourtSurface;
                            const environment = t.courtEnvironment ?? t.CourtEnvironment;

                            if (venueId && venueId != 0) option.setAttribute('data-venue-id', venueId);
                            if (surface !== undefined) option.setAttribute('data-surface', surface);
                            if (environment !== undefined) option.setAttribute('data-environment', environment);

                            tournamentSelect.appendChild(option);
                        });

                        tournamentSelect.disabled = false;

                        if (currentTournamentVal && Array.from(tournamentSelect.options).some(o => o.value == currentTournamentVal)) {
                            tournamentSelect.value = currentTournamentVal;
                            await syncTournamentMetadata();
                            await fetchAndPopulatePlayers(`/Matches/GetPlayersByTournament?tournamentId=${currentTournamentVal}&tour=${selectedTour}`);
                        }
                    }
                } catch (error) {
                    console.error('Error fetching data by tour:', error);
                }
            }

            if (tourSelect) {
                tourSelect.addEventListener('change', handleTourChange);
            }

            if (tournamentSelect) {
                tournamentSelect.addEventListener('change', async function() {
                    const tournamentId = this.value;
                    const selectedTour = tourSelect.value;

                    await syncTournamentMetadata();

                    if (tournamentId) {
                        await fetchAndPopulatePlayers(`/Matches/GetPlayersByTournament?tournamentId=${tournamentId}&tour=${selectedTour}`);
                    } else {
                        clearAndDisablePlayers();
                        clearAndDisableCourts();
                    }
                });
            }

            if (initialStatusValue && matchStatusSelect) {
                matchStatusSelect.value = initialStatusValue;
                matchStatusSelect.dispatchEvent(new Event('change')); // Triggers status UI behavior rules on load
            }            if (initialRoundValue && matchRoundSelect) matchRoundSelect.value = initialRoundValue;
            
            if (initialTourValue && tourSelect) {
                tourSelect.value = initialTourValue;
                await handleTourChange();  
            }

            function isMatchCompleted() {
                if (!matchStatusSelect || !matchStatusSelect.value) return false;
                const selectedOption = matchStatusSelect.options[matchStatusSelect.selectedIndex];
                return selectedOption && selectedOption.text.trim().toLowerCase() === 'completed';
            }

            function isMatchScheduled() {
                if (!matchStatusSelect || !matchStatusSelect.value) return false;
                const selectedOption = matchStatusSelect.options[matchStatusSelect.selectedIndex];
                return selectedOption && selectedOption.text.trim().toLowerCase() === 'scheduled';
            }

            function isMatchInProgress() {
                if (!matchStatusSelect || !matchStatusSelect.value) return false;
                const selectedOption = matchStatusSelect.options[matchStatusSelect.selectedIndex];
                const text = selectedOption ? selectedOption.text.trim().toLowerCase() : '';
                return text === 'inprogress' || text === 'in progress' || matchStatusSelect.value === '1';
            }

            function updateMatchStatusBehaviors() {
                if (scoreResultInput) {
                    if (isMatchScheduled()) {
                        scoreResultInput.value = "";
                        scoreResultInput.setAttribute("disabled", "disabled");
                        scoreResultInput.removeAttribute("required");
                    } else if (isMatchCompleted() || isMatchInProgress()) {
                        scoreResultInput.removeAttribute("disabled");
                        scoreResultInput.setAttribute("required", "required");
                    } else {
                        scoreResultInput.removeAttribute("disabled");
                        scoreResultInput.removeAttribute("required");
                    }
                }
                updateWinnerOptions(firstPlayer.value, secondPlayer.value);
            }

            function filterPlayerOptions() {
                const firstVal = firstPlayer.value;
                const secondVal = secondPlayer.value;

                Array.from(secondPlayer.options).forEach(option => {
                    option.disabled = (option.value && option.value === firstVal);
                    option.hidden = (option.value && option.value === firstVal);
                });

                Array.from(firstPlayer.options).forEach(option => {
                    option.disabled = (option.value && option.value === secondVal);
                    option.hidden = (option.value && option.value === secondVal);
                });

                updateMatchStatusBehaviors();
            }

            function updateWinnerOptions(firstVal, secondVal) {
                const currentWinnerVal = winnerSelect.value || initialWinnerValue;
                winnerSelect.innerHTML = '<option value="">-- Select Winner --</option>';

                if (firstVal && secondVal && isMatchCompleted()) {
                    const firstText = firstPlayer.options[firstPlayer.selectedIndex]?.text ?? '';
                    const secondText = secondPlayer.options[secondPlayer.selectedIndex]?.text ?? '';

                    const opt1 = document.createElement('option');
                    opt1.value = firstVal;
                    opt1.textContent = firstText;
                    winnerSelect.appendChild(opt1);

                    const opt2 = document.createElement('option');
                    opt2.value = secondVal;
                    opt2.textContent = secondText;
                    winnerSelect.appendChild(opt2);

                    winnerSelect.disabled = false;

                    if (currentWinnerVal === firstVal || currentWinnerVal === secondVal) {
                        winnerSelect.value = currentWinnerVal;
                    }
                } else {
                    winnerSelect.disabled = true;
                    winnerSelect.value = "";
                }
            }

            if (matchForm) {
                matchForm.addEventListener('submit', function() {
                    if (scoreResultInput) scoreResultInput.removeAttribute('disabled');
                    if (winnerSelect) winnerSelect.removeAttribute('disabled');
                    if (firstPlayer) firstPlayer.removeAttribute('disabled');
                    if (secondPlayer) secondPlayer.removeAttribute('disabled');
                    if (courtSelect) courtSelect.removeAttribute('disabled');
                    if (tournamentSelect) tournamentSelect.removeAttribute('disabled');
                });
            }

            if (firstPlayer) firstPlayer.addEventListener('change', filterPlayerOptions);
            if (secondPlayer) secondPlayer.addEventListener('change', filterPlayerOptions);

            if (matchStatusSelect) {
                matchStatusSelect.addEventListener('change', updateMatchStatusBehaviors);
            }

            if (courtSelect) {
                courtSelect.addEventListener('change', function() {
                    if (typeof $ !== 'undefined') {
                        $('#courtSelect').valid();
                    }
                });
            }

            await loadAllVenues();

            if (tourSelect && tourSelect.value) {
                await handleTourChange();
            } else {
                if (tournamentSelect) tournamentSelect.disabled = true;
                clearAndDisablePlayers();
                clearAndDisableCourts();
            }

            if (tournamentSelect && tournamentSelect.value) {
                await syncTournamentMetadata();
            }
            if (initialCourtValue && Array.from(courtSelect.options).some(o => o.value === initialCourtValue)) {
                courtSelect.value = initialCourtValue;
                courtSelect.dispatchEvent(new Event('change')); // Updates hidden surface/environment inputs
            }
            filterPlayerOptions();
        });
    </script>
}